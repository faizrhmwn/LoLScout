<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160" width="160" height="160">
  <defs>
    <linearGradient id="grad-DIG" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFC72C" stop-opacity="1" />
      <stop offset="100%" stop-color="#1A1A1A" stop-opacity="0.95" />
    </linearGradient>
    <filter id="glow-DIG" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <rect x="8" y="8" width="144" height="144" rx="28" fill="url(#grad-DIG)" stroke="#FFC72C" stroke-width="3" stroke-opacity="0.7"/>
  <rect x="14" y="14" width="132" height="132" rx="22" fill="#030712" fill-opacity="0.65"/>
  <text x="80" y="88" font-family="system-ui, -apple-system, sans-serif" font-size="38" font-weight="900" fill="#FFFFFF" text-anchor="middle" letter-spacing="1" filter="url(#glow-DIG)">DIG</text>
  <text x="80" y="122" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="800" fill="#FFC72C" text-anchor="middle" letter-spacing="3" text-transform="uppercase">LCS</text>
</svg>